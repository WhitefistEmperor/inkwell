{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix server install --omit=dev && npm --prefix client install",
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/dist",
  "build": {
    "env": {
      "VITE_REALTIME": "off"
    }
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 20,
      "includeFiles": "server/migrations/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
