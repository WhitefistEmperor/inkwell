{
  "name": "inkwell-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/with-db.js dev node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "seed": "node scripts/with-db.js dev node --env-file-if-exists=.env scripts/seed.js",
    "test": "node scripts/with-db.js test node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19",
    "supertest": "^7.3.2"
  }
}
